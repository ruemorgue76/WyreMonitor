<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Desktop app: Windows-only target, no console window. The Windows 10 API version gives
         access to Windows notifications (toasts). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.5.5</Version>
    <!-- Code signing (SignPath) checks these on every signed file: product name and a version
         equal to <Version>, without the commit hash .NET would otherwise append. -->
    <Product>WyreMonitor</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibreHardwareMonitor's kernel driver is x64; force the platform. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The same exe runs as the service (LocalSystem) and as the desktop app (user rights):
         see Program.cs. The manifest never asks for elevation. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Security: .NET must not load code named by environment variables (DOTNET_STARTUP_HOOKS). -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- Pin every dependency, transitive ones included, to the exact versions in packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>WyreMonitor</AssemblyName>
    <RootNamespace>WyreMonitor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows-only APIs (WindowsIdentity) are intentional; this app never runs elsewhere. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- WebView2 also ships a WPF assembly that this WinForms app never loads: its
         WindowsBase version conflict is harmless. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Build outputs live inside the project: never treat them as source. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;publish\**;installer\**;testing\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms namespaces clash with web and threading types (Timer): import them per file. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.9.7 prerelease adds PawnIO support: reads CPU SMU + Super-I/O with
         Windows Memory Integrity (HVCI) enabled, where WinRing0 is blocked. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre705" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Runs the sensor half as a Windows service. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <!-- Finds the disk Windows runs from (already a dependency of LibreHardwareMonitorLib). -->
    <PackageReference Include="System.Management" Version="10.0.9" />
  </ItemGroup>

  <!-- Copy wwwroot next to the binary so static files are served even when the
       app runs from bin/ in the Production environment (not just via publish). -->
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
