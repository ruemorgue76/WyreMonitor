<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": WyreMonitor-Setup-<version>.exe, built by
     Inno Setup from the already signed app. The workflow uploads it as a ZIP. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="WyreMonitor-Setup-*.exe" product-name="WyreMonitor" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
